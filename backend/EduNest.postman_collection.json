	"item": [
		{
			"name": "00 Health",
			"item": [
				{
					"name": "GET Health",
					"request": {
						"description": "Public liveness probe. No auth. Expect `{ ok: true, data: { service: 'edunest-api', db, time } }`.",
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "01 Auth",
			"description": "Run in order 01 → 09. Login as super-admin once; cookies auth the rest.",
			"item": [
				{
					"name": "01 Admin Request - Approve Flow (Sunrise School)",
					"request": {
						"description": "Public. Creates Institute(status=pending) + User(admin,status=pending). Returns `{ instituteId, status: 'pending' }`. Test script saves `instituteId`. Re-run with a fresh email (duplicate email → 409).",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Demo Admin One\",\n  \"email\": \"demo.admin1@sunrise-school.in\",\n  \"password\": \"Demo@1234\",\n  \"schoolName\": \"Sunrise Public School\",\n  \"address\": \"MG Road, Pune\",\n  \"phone\": \"9876543210\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/admin-request",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"admin-request"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json.ok && json.data && json.data.instituteId) {",
									"    pm.collectionVariables.set('instituteId', json.data.instituteId);",
									"    console.log('Saved instituteId:', json.data.instituteId);",
									"}"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "02 Admin Request - Reject Flow (Lakeview School)",
					"request": {
						"description": "Second pending school, used to demo the REJECT flow. Test script saves `rejectInstituteId`.",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Demo Admin Two\",\n  \"email\": \"reject.admin@lakeview-school.in\",\n  \"password\": \"Demo@1234\",\n  \"schoolName\": \"Lakeview International School\",\n  \"address\": \"Lake Road, Udaipur\",\n  \"phone\": \"9812345678\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/admin-request",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"admin-request"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json.ok && json.data && json.data.instituteId) {",
									"    pm.collectionVariables.set('rejectInstituteId', json.data.instituteId);",
									"    console.log('Saved rejectInstituteId:', json.data.instituteId);",
									"}"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "03 Admin Request - Validation Error (expect 400)",
					"request": {
						"description": "Negative test: bad email + short password + missing schoolName → 400 with zod details. Proves validator wiring.",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"X\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"schoolName\": \"\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/admin-request",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"admin-request"
							]
						}
					},
					"response": []
				},
				{
					"name": "04 Login - Super Admin (sets cookies)",
					"request": {
						"description": "Public (rate-limited: 10/min portal, 5/min console via X-Client). Body identifier = email OR loginId. Sets httpOnly cookies `edunest_token` (15min) + `edunest_refresh` (7d). Update `superEmail/superPassword` collection variables from your backend/.env first.",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Client",
								"value": "console",
								"description": "console = stricter 5/min limiter; portal = 10/min"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"{{superEmail}}\",\n  \"password\": \"{{superPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "05 Login - Pending Admin (expect 403)",
					"request": {
						"description": "Negative test: admin from request 01/02 logs in BEFORE approval → 403 'Account pending approval'. After approval this same body returns 200.",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Client",
								"value": "console"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"demo.admin1@sunrise-school.in\",\n  \"password\": \"Demo@1234\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "06 Login - Wrong Password (expect 401)",
					"request": {
						"description": "Negative test: valid identifier + wrong password → 401 'Invalid credentials' (generic, no user enumeration).",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Client",
								"value": "console"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"{{superEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "07 Get Session (me)",
					"request": {
						"description": "Auth required (cookie). Returns `{ user, banner: { adminSuspended, instituteStatus } }`. Super-admin gets `instituteStatus: 'none'`. No status gate here by design so frontends can render pending/suspended banners.",
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"me"
							]
						}
					},
					"response": []
				},
				{
					"name": "08 Refresh Session",
					"request": {
						"description": "Auth via refresh cookie. Reads `edunest_refresh`, rotates it, re-sets both cookies, returns `{ user }`. Old refresh token is invalidated (reuse → 401). Works even if access token expired.",
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						}
					},
					"response": []
				},
				{
					"name": "09 Logout (run last in Auth)",
					"request": {
						"description": "Clears both cookies + revokes stored refresh hash server-side. Run LAST — after this, Super requests return 401 until you re-login (04).",
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"logout"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02 Super - Approval Queue",
			"description": "All require super-admin cookie (login 04 first). `protect → allowRoles(super-admin) → checkStatus`.",
			"item": [
				{
					"name": "List Requests - pending",
					"request": {
						"description": "Default queue view. `GET /api/super/requests?status=pending`. Shows institute + requesting admin profile only — no student/teacher data.",
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/super/requests?status=pending",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"super",
								"requests"
							],
							"query": [
								{
									"key": "status",
									"value": "pending"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "List Requests - active",
					"request": {
						"description": "Already-approved queue. `?status=active`. After approving, your Sunrise row moves here.",
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/super/requests?status=active",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"super",
								"requests"
							],
							"query": [
								{
									"key": "status",
									"value": "active"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "List Requests - rejected",
					"request": {
						"description": "Rejected queue. Note: rejected = institute stays pending + admin=rejected (record preserved), filtered on admin row.",
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/super/requests?status=rejected",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"super",
								"requests"
							],
							"query": [
								{
									"key": "status",
									"value": "rejected"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Approve Request",
					"request": {
						"description": "Sets Institute=active + Admin=active, writes AuditLog. Idempotent (re-approve → same 200). Uses `{{instituteId}}` auto-saved from Auth/01. Replace `:id` with a real ObjectId from the pending list.",
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/super/requests/{{instituteId}}/approve",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"super",
								"requests",
								"{{instituteId}}",
								"approve"
							]
						}
					},
					"response": []
				},
				{
					"name": "Reject Request",
					"request": {
						"description": "Body `{ reason (min 3 chars) }`. Only pending can be rejected. Already-approved → 400 'use block-admin instead'. Uses `{{rejectInstituteId}}` auto-saved from Auth/02.",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"Demo rejection — incomplete school address proof\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/super/requests/{{rejectInstituteId}}/reject",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"super",
								"requests",
								"{{rejectInstituteId}}",
								"reject"
							]
						}
					},
					"response": []
				},
				{
					"name": "Approve - Invalid ID (expect 400)",
					"request": {
						"description": "Negative test: malformed ObjectId → 400 'Invalid id format' (not 500). Unknown-but-valid ObjectId → 404.",
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/super/requests/not-a-valid-id/approve",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"super",
								"requests",
								"not-a-valid-id",
								"approve"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "03 Super - Institutes Directory",
			"description": "Counts-only directory — never returns student/teacher PII, marks, fee rows, or complaint bodies.",
			"item": [
				{
					"name": "Direct Create Institute + Admin (offline onboarding)",
					"request": {
						"description": "Super-admin creates ACTIVE institute + admin directly (no approval). Returns `{ instituteId, adminEmail, tempPassword }` — tempPassword shown ONCE. Test script saves `instituteId` + `tempPassword`. Duplicate adminEmail → 409.",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"schoolName\": \"Greenwood Academy\",\n  \"address\": \"Park Street, Kolkata\",\n  \"phone\": \"9123456780\",\n  \"adminName\": \"Offline Admin\",\n  \"adminEmail\": \"offline.admin@greenwood-academy.in\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/super/institutes",
							"host": [
